{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-decorations",
    "drag:default",
    "updater:default",
    "process:default",
    "dialog:default",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file"
  ]
}
