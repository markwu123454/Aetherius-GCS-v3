<?xml version="1.0" encoding="utf-8"?>
<!-- Puts the install folder, which holds aetherius-cli.exe, on the system
     PATH (the MSI installs for all users). Windows Installer takes it off
     again on uninstall. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="CliPath" Guid="{076912D0-65AD-497C-A4FD-8F37777D6588}">
        <RegistryValue Root="HKLM" Key="Software\[Manufacturer]\[ProductName]" Name="CliPath" Type="integer" Value="1" KeyPath="yes"/>
        <Environment Id="CliPathEntry" Name="PATH" Value="[INSTALLDIR]" Part="last" Action="set" System="yes" Permanent="no"/>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
